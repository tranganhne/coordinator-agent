@startuml coordinator_component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_TOP_DOWN()
title Coordinator Agent - mô hình thành phần (C4 Component)

Container(orchestration, "LangGraph Orchestration", "LangGraph", "Điều phối agent, quản lý State, quyết định thứ tự, retry khi lỗi")
Container(arch_extraction, "Architecture Extraction Agent", "LangGraph", "Dựng đồ thị kiến trúc thiết kế; đọc chiến lược quét")
Container(code_analysis, "Code Analysis Agent", "LangGraph", "Dựng đồ thị phụ thuộc thực tế; đọc chiến lược quét")
Container(consistency, "Consistency Checking Agent", "LangGraph", "Reflexion Model + Rule Engine + Similarity -> findings")
Container(reporting, "Reporting Agent", "LangGraph", "Báo cáo, đồ thị, đề xuất sửa")
ContainerDb(kb_raw, "KB - tầng raw/audit", "DB", "Mỗi agent ghi collection riêng; Coordinator KHÔNG ghi tầng này")
ContainerDb(kb_unified, "KB - tầng unified", "SQLite", "scan_index, unified_findings, delta_results, scan_strategies; chỉ Coordinator ghi")

Container_Boundary(coordinator, "Coordinator Agent") {
  Component(agent, "CoordinatorAgent (subgraph LangGraph)", "coordinator_agent/agent.py", "Điều phối nội bộ 8 node; hai nhánh ra tách biệt")
  Component(kb_reader, "KB Reader", "coordinator_agent/knowledge/kb_reader.py", "Đọc lần quét trước + chiến lược cũ [NV 7]")
  Component(normalizer, "Normalizer", "coordinator_agent/aggregation/normalizer.py", "Chuẩn hóa severity, đường dẫn, confidence [NV 3]")
  Component(aggregator, "Aggregator", "coordinator_agent/aggregation/aggregator.py", "Gom finding cùng fingerprint [NV 1]")
  Component(conflict_resolver, "Conflict Resolver", "coordinator_agent/aggregation/conflict_resolver.py", "score = reliability x confidence; eps = 0.15 [NV 2]")
  Component(delta_analyzer, "Delta Analyzer", "coordinator_agent/delta/delta_analyzer.py", "New / Persistent / Resolved; not_rescanned [NV 8]")
  Component(strategy_planner, "Strategy Planner", "coordinator_agent/strategy_planner.py", "Pha Plan: đề xuất chiến lược quét lần sau [NV Plan]")
  Component(integrity, "Integrity Validator", "coordinator_agent/knowledge/integrity.py", "Kiểm tra toàn vẹn trước khi ghi [NV 6]")
  Component(kb_writer, "KB Writer (Single Writer)", "coordinator_agent/knowledge/kb_writer.py", "Ghi tầng unified trong 1 transaction, upsert [NV 9]")
  Component(payload_builder, "Payload Builder", "coordinator_agent/payload_builder.py", "Gói ReportingPayload + gợi ý cho agent khác [NV 4, 10]")
  Component(intermediate_store, "Intermediate Store", "coordinator_agent/intermediate_store.py", "Kết quả trung gian theo scan_id [NV 5]")
  Component(fingerprint, "Fingerprint", "coordinator_agent/delta/fingerprint.py", "SHA-256(rule_id+nguồn+đích+file)")
  Component(config, "Config", "config.py + config.yaml", "Trọng số tin cậy nguồn, ngưỡng")
}

Rel(orchestration, agent, "run(context, consistency_result)")
Rel(consistency, agent, "ConsistencyResult (qua State)")
Rel(agent, kb_reader, "1. Đọc lịch sử")
Rel(kb_reader, kb_unified, "SELECT lần quét trước")
Rel(agent, normalizer, "2. Chuẩn hóa")
Rel(agent, aggregator, "3. Gom nhóm")
Rel(aggregator, fingerprint, "Tính fingerprint")
Rel(agent, conflict_resolver, "4. Hòa giải xung đột")
Rel(conflict_resolver, config, "Trọng số tin cậy, eps")
Rel(agent, delta_analyzer, "5. Phân loại delta")
Rel(agent, strategy_planner, "6. Đề xuất chiến lược")
Rel(agent, intermediate_store, "Lưu kết quả trung gian")
Rel(agent, integrity, "7a. Kiểm tra toàn vẹn")
Rel(integrity, kb_reader, "Baseline có tồn tại?")
Rel(agent, kb_writer, "7b. Ghi (Single Writer)")
Rel(kb_writer, kb_unified, "Ghi unified + delta + chiến lược")
Rel(agent, payload_builder, "7c. Đóng gói (song song với 7a-7b)")
Rel(payload_builder, reporting, "ReportingPayload (qua State)")
Rel(arch_extraction, consistency, "Đồ thị thiết kế")
Rel(code_analysis, consistency, "Đồ thị thực tế")
Rel(consistency, kb_raw, "Ghi raw metadata")
Rel(arch_extraction, kb_raw, "Ghi raw findings")
Rel(code_analysis, kb_raw, "Ghi raw findings")
Rel(kb_unified, arch_extraction, "Đọc chiến lược quét")
Rel(kb_unified, code_analysis, "Đọc chiến lược quét")

@enduml
